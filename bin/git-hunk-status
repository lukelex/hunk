#!/usr/bin/env python3
"""Color Git's status while retaining its native layout."""

import os
import re
import subprocess
import sys


def main():
  args = sys.argv[1:]
  options = args[:args.index("--")] if "--" in args else args
  # Machine formats and redirected output belong entirely to Git.
  raw = any((arg.startswith("-") and not arg.startswith("--") and "z" in arg)
            or arg == "--null"
            or arg.startswith("--porcelain") for arg in options)
  command = ["git", "-c", "color.status=false", "-c", "column.status=never",
             "-c", "status.short=false", "status", *args]
  if raw or not sys.stdout.isatty():
    os.execvp(command[0], command)

  theme = os.environ.get("HUNK_THEME")
  if not theme:
    config = subprocess.run(["git", "config", "--get", "hunk.theme"],
                            stdout=subprocess.PIPE)
    theme = config.stdout.decode().strip() or "default"
  if theme not in ("default", "railscasts"):
    print(f"hunk: unknown theme: {theme}", file=sys.stderr)
    return 2

  # Railscasts blue, DiffAdd green and DiffDelete red, shared with the diff theme.
  blue, green, red = (("38;2;109;156;190", "38;2;135;175;95", "38;2;218;73;57")
                      if theme == "railscasts" else ("94", "32", "31"))
  colors = {"M": blue, "T": blue, "R": blue, "A": green, "C": green,
            "D": red}
  result = subprocess.run(command, stdout=subprocess.PIPE)
  if result.returncode:
    return result.returncode

  def paint(text, color):
    return b"\x1b[" + color.encode() + b"m" + text + b"\x1b[m" if color else text

  labels = {b"modified": blue, b"typechange": blue, b"renamed": blue,
            b"new file": green, b"copied": green, b"deleted": red}
  section = None
  for line in result.stdout.splitlines(keepends=True):
    if line.startswith((b"Changes to be committed:", b"Changes not staged for commit:")):
      section = "changes"
    elif line.startswith(b"Unmerged paths:"):
      section = "conflicts"
    elif line and line[:1] not in (b" ", b"\t", b"\n"):
      section = None
    if section and line.startswith(b"\t"):
      label = line[1:].split(b":", 1)[0]
      color = red if section == "conflicts" else labels.get(label)
      sys.stdout.buffer.write(b"\t" + paint(line[1:].removesuffix(b"\n"), color)
                              + (b"\n" if line.endswith(b"\n") else b""))
      continue
    if not re.match(rb"[ MADRCUT?!]{2} ", line):
      sys.stdout.buffer.write(line)
      continue
    x, y = chr(line[0]), chr(line[1])
    # Conflicts are always red; untracked/ignored entries stay neutral.
    conflict = "U" in (x, y) or x + y in ("AA", "DD")
    path_color = red if conflict else colors.get(y if y != " " else x)
    sys.stdout.buffer.write(paint(line[:1], red if conflict else colors.get(x))
                            + paint(line[1:2], red if conflict else colors.get(y))
                            + b" " + paint(line[3:].removesuffix(b"\n"), path_color)
                            + (b"\n" if line.endswith(b"\n") else b""))
  return 0


if __name__ == "__main__":
  sys.exit(main())
