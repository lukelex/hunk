#!/usr/bin/env python3
"""Color Git's status while retaining its native layout."""

import os
import re
import subprocess
import sys


def main():
  args = sys.argv[1:]
  options = args[:args.index("--")] if "--" in args else args
  hints = "--hints" in options
  if hints:
    args.remove("--hints")
    options = args[:args.index("--")] if "--" in args else args
  # Machine formats and redirected output belong entirely to Git.
  raw = any((arg.startswith("-") and not arg.startswith("--") and "z" in arg)
            or arg == "--null"
            or arg.startswith("--porcelain") for arg in options)
  command = ["git", "-c", "color.status=false", "-c", "column.status=never",
             "-c", "status.short=false", "status", *args]
  if raw or not sys.stdout.isatty():
    os.execvp(command[0], command)

  theme = os.environ.get("HUNK_THEME")
  if not theme:
    config = subprocess.run(["git", "config", "--get", "hunk.theme"],
                            stdout=subprocess.PIPE)
    theme = config.stdout.decode().strip() or "default"
  if theme not in ("default", "railscasts"):
    print(f"hunk: unknown theme: {theme}", file=sys.stderr)
    return 2

  # Railscasts blue, DiffAdd green and DiffDelete red, shared with the diff theme.
  blue, green, red, light_gray = (
      ("38;2;109;156;190", "38;2;135;175;95", "38;2;218;73;57", "38;2;189;195;199")
      if theme == "railscasts" else ("94", "32", "31", "97"))
  colors = {"M": blue, "T": blue, "R": blue, "A": green, "C": green,
            "D": red}
  compact = not hints and not any(arg in ("--long", "--short", "--verbose")
                                  or (arg.startswith("-") and not arg.startswith("--")
                                      and any(flag in arg for flag in "sv"))
                                  for arg in options)
  result = subprocess.run(command, stdout=subprocess.PIPE,
                          env=dict(os.environ, LC_ALL="C"))
  if result.returncode:
    return result.returncode

  def paint(text, color):
    return b"\x1b[" + color.encode() + b"m" + text + b"\x1b[m" if color else text

  labels = {b"modified": blue, b"typechange": blue, b"renamed": blue,
            b"new file": green, b"copied": green, b"deleted": red}
  if compact:
    headings = {b"Changes to be committed:": b"Staged",
                b"Changes not staged for commit:": b"Unstaged",
                b"Untracked files:": b"Untracked",
                b"Unmerged paths:": b"Conflicts",
                b"Ignored files:": b"Ignored"}
    groups = []
    preamble = []
    for line in result.stdout.splitlines():
      if line in headings:
        groups.append((headings[line], []))
      elif groups and line.startswith(b"\t"):
        groups[-1][1].append(line[1:])
      elif not groups and line and not line.lstrip().startswith(b"("):
        preamble.append(line)
    output = [b"\n".join(preamble)]
    for heading, entries in groups:
      output.append(b"")
      output.append(paint(heading + " · ".encode() + str(len(entries)).encode(), "1"))
      for entry in entries:
        label, sep, path = entry.partition(b":")
        color = red if heading == b"Conflicts" else labels.get(label, light_gray)
        output.append(b"  " + paint(entry, color))
    sys.stdout.buffer.write(b"\n".join(output) + b"\n")
    return 0
  section = None
  untracked_section = False
  for line in result.stdout.splitlines(keepends=True):
    if line.startswith((b"Changes to be committed:", b"Changes not staged for commit:")):
      section = "changes"
    elif line.startswith(b"Unmerged paths:"):
      section = "conflicts"
      untracked_section = False
    elif line.startswith(b"Untracked files:"):
      section = None
      untracked_section = True
    elif line and line[:1] not in (b" ", b"\t", b"\n"):
      section = None
      untracked_section = False
    if section and line.startswith(b"\t"):
      label = line[1:].split(b":", 1)[0]
      color = red if section == "conflicts" else labels.get(label)
      sys.stdout.buffer.write(b"\t" + paint(line[1:].removesuffix(b"\n"), color)
                              + (b"\n" if line.endswith(b"\n") else b""))
      continue
    if untracked_section and line.startswith(b"\t"):
      sys.stdout.buffer.write(b"\t" + paint(line[1:].removesuffix(b"\n"), light_gray)
                              + (b"\n" if line.endswith(b"\n") else b""))
      continue
    if line.startswith(b"?? "):
      sys.stdout.buffer.write(line[:3] + paint(line[3:].removesuffix(b"\n"), light_gray)
                              + (b"\n" if line.endswith(b"\n") else b""))
      continue
    if not re.match(rb"[ MADRCUT?!]{2} ", line):
      sys.stdout.buffer.write(line)
      continue
    x, y = chr(line[0]), chr(line[1])
    # Conflicts are always red; untracked paths are light gray.
    conflict = "U" in (x, y) or x + y in ("AA", "DD")
    path_color = (red if conflict else light_gray if x == "?" and y == "?"
                  else colors.get(y if y != " " else x))
    sys.stdout.buffer.write(paint(line[:1], red if conflict else colors.get(x))
                            + paint(line[1:2], red if conflict else colors.get(y))
                            + b" " + paint(line[3:].removesuffix(b"\n"), path_color)
                            + (b"\n" if line.endswith(b"\n") else b""))
  return 0


if __name__ == "__main__":
  sys.exit(main())
