#!/usr/bin/env bash
set -euo pipefail

if ! command -v delta >/dev/null 2>&1; then
  printf 'hunk: install git-delta for formatted diffs; showing the original patch.\n' >&2
  exec less --tabs=4 -RFX
fi

here=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
theme=${HUNK_THEME:-$(git config --get hunk.theme || true)}
theme=${theme:-default}
case "$theme" in
  default|railscasts|light) ;;
  *) printf 'hunk: unknown theme: %s\n' "$theme" >&2; exit 2 ;;
esac
# Delta's environment selector takes precedence over --features.
export DELTA_FEATURES="$theme"
exec "$here/hunk-render" --features "$theme" "$@"
