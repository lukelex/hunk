[delta]
  side-by-side = false
  line-numbers = false
  keep-plus-minus-markers = true
  file-decoration-style = none
  hunk-header-decoration-style = none
  hunk-label = "@@ "
  commit-style = raw
  commit-decoration-style = none
  tabs = 4
  width = variable
  max-line-length = 0

[delta "default"]
  dark = true
  file-style = bold normal
  hunk-header-style = normal line-number
  hunk-header-line-number-style = "#888888"
  inline-hint-style = dim normal
  minus-style = red normal
  plus-style = green normal
  minus-emph-style = brightred bold 52
  plus-emph-style = brightgreen bold 22
  zero-style = "#9A9A9A normal"
  whitespace-error-style = magenta reverse

# Palette: lukelex/railscasts.nvim, lua/railscasts/colors.lua.
# Addition/removal/change colors match its DiffAdd/DiffDelete/DiffChange groups.
[delta "railscasts"]
  dark = true
  file-style = "bold #E6E1DC"
  hunk-header-style = "#BDC3C7 line-number"
  hunk-header-line-number-style = "#8A8178"
  inline-hint-style = "#6D9CBE"
  minus-style = "#CC7833 normal"
  plus-style = "#87AF5F normal"
  minus-emph-style = "bold #DA4939 #402828"
  plus-emph-style = "bold #A5C779 #283D28"
  zero-style = "#A79B90 normal"
  whitespace-error-style = "reverse #DA4939"

[delta "light"]
  light = true
  file-style = "bold #24292F"
  hunk-header-style = "#424A53 line-number"
  hunk-header-line-number-style = "#68717A"
  inline-hint-style = "#68717A"
  minus-style = "#A12622 normal"
  plus-style = "#236B35 normal"
  minus-emph-style = "bold #82071E #FFCECB"
  plus-emph-style = "bold #116329 #CCFFD8"
  zero-style = "#626B74 normal"
  whitespace-error-style = "reverse #A12622"
